  typeset -g POWERLEVEL9K_DIR_BACKGROUND='#4D5CCB'
  typeset -g POWERLEVEL9K_DIR_FOREGROUND='#FFFFFF'
  typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND='#DDE6FF'
  typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND='#FFFFFF'

  typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND='#9ABBFE'
  typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND='#E4D29A'
  typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND='#7F91E8'
  typeset -g POWERLEVEL9K_VCS_CONFLICTED_BACKGROUND='#B66A86'
  typeset -g POWERLEVEL9K_VCS_LOADING_BACKGROUND='#181F34'

  typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND='#9ABBFE'
  typeset -g POWERLEVEL9K_STATUS_OK_BACKGROUND='#101523'
  typeset -g POWERLEVEL9K_STATUS_OK_PIPE_FOREGROUND='#9ABBFE'
  typeset -g POWERLEVEL9K_STATUS_OK_PIPE_BACKGROUND='#101523'
  typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND='#E4D29A'
  typeset -g POWERLEVEL9K_STATUS_ERROR_BACKGROUND='#101523'
  typeset -g POWERLEVEL9K_STATUS_ERROR_SIGNAL_FOREGROUND='#E4D29A'
  typeset -g POWERLEVEL9K_STATUS_ERROR_SIGNAL_BACKGROUND='#101523'
  typeset -g POWERLEVEL9K_STATUS_ERROR_PIPE_FOREGROUND='#E4D29A'
  typeset -g POWERLEVEL9K_STATUS_ERROR_PIPE_BACKGROUND='#101523'

  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND='#E4D29A'
  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_BACKGROUND='#181F34'
  typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND='#9ABBFE'
  typeset -g POWERLEVEL9K_BACKGROUND_JOBS_BACKGROUND='#101523'
  typeset -g POWERLEVEL9K_TIME_FOREGROUND='#A8B3D7'
  typeset -g POWERLEVEL9K_TIME_BACKGROUND='#101523'

  typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND='#A8B3D7'
  typeset -g POWERLEVEL9K_CONTEXT_BACKGROUND='#101523'
  typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND='#E4D29A'
  typeset -g POWERLEVEL9K_CONTEXT_ROOT_BACKGROUND='#101523'
  typeset -g POWERLEVEL9K_CONTEXT_{REMOTE,REMOTE_SUDO}_FOREGROUND='#9ABBFE'
  typeset -g POWERLEVEL9K_CONTEXT_{REMOTE,REMOTE_SUDO}_BACKGROUND='#101523'

  typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='#9ABBFE'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='#E4D29A'
  typeset -g POWERLEVEL9K_VI_MODE_INSERT_FOREGROUND='#A8B3D7'
  typeset -g POWERLEVEL9K_VI_MODE_NORMAL_BACKGROUND='#4D5CCB'
  typeset -g POWERLEVEL9K_VI_MODE_VISUAL_BACKGROUND='#4D5CCB'
  typeset -g POWERLEVEL9K_VI_MODE_OVERWRITE_BACKGROUND='#B66A86'

  typeset -g POWERLEVEL9K_{DIRENV,RANGER,YAZI,MIDNIGHT_COMMANDER,NODENV,NODEENV,TERRAFORM_OTHER,TERRAFORM_VERSION,AWS_EB_ENV,PROXY}_FOREGROUND=109
  typeset -g POWERLEVEL9K_{DIRENV,RANGER,YAZI,MIDNIGHT_COMMANDER,NODENV,NODEENV,TERRAFORM_OTHER,TERRAFORM_VERSION,AWS_EB_ENV,PROXY}_BACKGROUND=236
  typeset -g POWERLEVEL9K_{VIRTUALENV,ANACONDA,PYENV,GOENV,NVM,FVM,LUAENV,PLENV,CHEZMOI_SHELL,NIX_SHELL}_FOREGROUND=110
  typeset -g POWERLEVEL9K_{VIRTUALENV,ANACONDA,PYENV,GOENV,NVM,FVM,LUAENV,PLENV,CHEZMOI_SHELL,NIX_SHELL}_BACKGROUND=237
  typeset -g POWERLEVEL9K_{RBENV,RVM,PHPENV,PHP_VERSION,DOTNET_VERSION,PACKAGE,KUBECONTEXT_DEFAULT,AZURE_OTHER,GCLOUD,GOOGLE_APP_CRED_DEFAULT}_FOREGROUND=146
  typeset -g POWERLEVEL9K_{RBENV,RVM,PHPENV,PHP_VERSION,DOTNET_VERSION,PACKAGE,KUBECONTEXT_DEFAULT,AZURE_OTHER,GCLOUD,GOOGLE_APP_CRED_DEFAULT}_BACKGROUND=236
  typeset -g POWERLEVEL9K_{NORDVPN,NNN,LF,XPLR,TOOLBOX,TASKWARRIOR,VPN_IP,IP,WIFI}_FOREGROUND=116
  typeset -g POWERLEVEL9K_{NORDVPN,NNN,LF,XPLR,TOOLBOX,TASKWARRIOR,VPN_IP,IP,WIFI}_BACKGROUND=236
  typeset -g POWERLEVEL9K_{TODO,TIMEWARRIOR,PER_DIRECTORY_HISTORY_LOCAL,PER_DIRECTORY_HISTORY_GLOBAL,CPU_ARCH,RAM,SWAP,LOAD_NORMAL,LOAD_WARNING,DISK_USAGE_NORMAL,DISK_USAGE_WARNING}_FOREGROUND=180
  typeset -g POWERLEVEL9K_{TODO,TIMEWARRIOR,PER_DIRECTORY_HISTORY_LOCAL,PER_DIRECTORY_HISTORY_GLOBAL,CPU_ARCH,RAM,SWAP,LOAD_NORMAL,LOAD_WARNING,DISK_USAGE_NORMAL,DISK_USAGE_WARNING}_BACKGROUND=237
  typeset -g POWERLEVEL9K_{LOAD_CRITICAL,DISK_USAGE_CRITICAL,AWS_DEFAULT}_FOREGROUND=167
  typeset -g POWERLEVEL9K_{LOAD_CRITICAL,DISK_USAGE_CRITICAL,AWS_DEFAULT}_BACKGROUND=236

  typeset -g POWERLEVEL9K_ASDF_FOREGROUND=110
  typeset -g POWERLEVEL9K_ASDF_BACKGROUND=237
  typeset -g POWERLEVEL9K_ASDF_{RUBY,PYTHON,GOLANG,NODEJS,RUST,DOTNET_CORE,FLUTTER,LUA,JAVA,PERL,ERLANG,ELIXIR,POSTGRES,PHP,HASKELL,JULIA}_FOREGROUND=110
  typeset -g POWERLEVEL9K_ASDF_{RUBY,PYTHON,GOLANG,NODEJS,RUST,DOTNET_CORE,FLUTTER,LUA,JAVA,PERL,ERLANG,ELIXIR,POSTGRES,PHP,HASKELL,JULIA}_BACKGROUND=237

  # Transient prompt works similarly to the builtin transient_rprompt option. It trims down prompt
  # when accepting a command line. Supported values:
  #
  #   - off:      Don't change prompt when accepting a command line.
  #   - always:   Trim down prompt when accepting a command line.
  #   - same-dir: Trim down prompt when accepting a command line unless this is the first command
  #               typed after changing current working directory.
  typeset -g POWERLEVEL9K_TRANSIENT_PROMPT=always

  # Instant prompt mode.
  #
  #   - off:     Disable instant prompt. Choose this if you've tried instant prompt and found
  #              it incompatible with your zsh configuration files.
  #   - quiet:   Enable instant prompt and don't print warnings when detecting console output
  #              during zsh initialization. Choose this if you've read and understood
  #              https://github.com/romkatv/powerlevel10k#instant-prompt.
  #   - verbose: Enable instant prompt and print a warning when detecting console output during
  #              zsh initialization. Choose this if you've never tried instant prompt, haven't
  #              seen the warning, or if you are unsure what this all means.
  typeset -g POWERLEVEL9K_INSTANT_PROMPT=verbose

  # Hot reload allows you to change POWERLEVEL9K options after Powerlevel10k has been initialized.
  # For example, you can type POWERLEVEL9K_BACKGROUND=red and see your prompt turn red. Hot reload
  # can slow down prompt by 1-2 milliseconds, so it's better to keep it turned off unless you
  # really need it.
  typeset -g POWERLEVEL9K_DISABLE_HOT_RELOAD=true

  # If p10k is already loaded, reload configuration.
  # This works even with POWERLEVEL9K_DISABLE_HOT_RELOAD=true.
  (( ! $+functions[p10k] )) || p10k reload
}

# Tell `p10k configure` which file it should overwrite.
typeset -g POWERLEVEL9K_CONFIG_FILE=${${(%):-%x}:a}

(( ${#p10k_config_opts} )) && setopt ${p10k_config_opts[@]}
'builtin' 'unset' 'p10k_config_opts'
